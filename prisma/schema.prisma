generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  direct
  group
}

enum MemberRole {
  admin
  member
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships  ChatMember[]
  createdChats Chat[]       @relation("ChatCreator")

  @@map("users")
}

model Chat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ChatType
  name      String?
  directKey String?  @unique @map("direct_key")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  creator User?        @relation("ChatCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  members ChatMember[]

  @@map("chats")
}

model ChatMember {
  chatId   String     @map("chat_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole @default(member)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}
